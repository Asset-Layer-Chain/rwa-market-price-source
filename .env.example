PORT=3002

# CoinMarketCap (현재 코드에서 비활성화 상태)
CMC_API_KEY=
# CMC_IDS=1,1027

# 수집 주기 (ms)
BINANCE_INTERVAL_MS=5000
GATE_INTERVAL_MS=5000
CMC_INTERVAL_MS=180000
# 주의: 코드에서 BINQUOTE (오타) 이름으로 읽습니다. 그대로 사용하세요.
BINQUOTE_INTERVAL_MS=5000

# PostgreSQL (src/db.js 는 아래 DB_* 값만 사용합니다)
DB_HOST=localhost
DB_PORT=5432
DB_USER=market_user
DB_PASSWORD=
DB_NAME=market_db

# 현재 코드에서 사용하지 않음
DATABASE_URL=

# Control read-only adapter (node --env-file=.env src/integration/server.mjs)
SOURCE_MODE=offline
HOST=127.0.0.1
PRICE_MAX_LATENCY_MS=10000
INTERNAL_SERVICE_TOKEN=
