# ===========================
# 비밀 정보 (절대 커밋 금지)
# ===========================
# .env 에는 CMC API 키, DB 비밀번호 등이 들어 있습니다.
# 새 환경 변수를 추가하면 .env.example 에 "키 이름만" 추가하세요.
.env
.env.*
!.env.example
*.local

# ===========================
# 의존성
# ===========================
node_modules/
frontend/node_modules/

# ===========================
# 빌드 결과물 / 캐시
# ===========================
frontend/dist/
dist/
.vite/
.cache/
coverage/

# ===========================
# 로그
# ===========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===========================
# OS / 에디터
# ===========================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ===========================
# 로컬 Claude Code 설정
# ===========================
.claude/settings.local.json
